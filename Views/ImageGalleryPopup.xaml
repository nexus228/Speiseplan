<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Speiseplan.Views.ImageGalleryPopup"
               x:TypeArguments="x:String">

    <Border StrokeShape="RoundRectangle 12"
            Stroke="Transparent"
            BackgroundColor="White"
            Padding="10"
            WidthRequest="350"
            HeightRequest="450">

        <Grid RowDefinitions="Auto,*,Auto">

            <Label Grid.Row="0" Text="Bilder" FontSize="18" FontAttributes="Bold"
                   Margin="0,0,0,10" HorizontalOptions="Center" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding ImageUrls}"
                             SelectionMode="Single"
                             SelectedItem="{Binding SelectedImageUrl}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Image Source="{Binding .}" Aspect="AspectFill" HeightRequest="150" />

                            <Border x:Name="CheckOverlay"
                                    BackgroundColor="{StaticResource Black}"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="24" HeightRequest="24"
                                    HorizontalOptions="End" VerticalOptions="Start"
                                    Margin="6"
                                    IsVisible="False">
                                <Label Text="✓" TextColor="White" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter TargetName="CheckOverlay" Property="IsVisible" Value="True" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="2" Text="OK" BackgroundColor="{StaticResource Primary}" Command="{Binding ImageSelectedCommand}"  CommandParameter="{Binding SelectedImageUrl}"/>

        </Grid>
    </Border>
</toolkit:Popup>