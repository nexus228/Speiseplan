<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Speiseplan.Views.ImageGalleryPopup"
               x:TypeArguments="x:String">

    <Border StrokeShape="RoundRectangle 12"
            Stroke="Transparent"
            BackgroundColor="White"
            Padding="10"
            WidthRequest="350"
            HeightRequest="450">

        <Grid RowDefinitions="Auto,*">

            <Label Grid.Row="0" Text="Bilder" FontSize="18" FontAttributes="Bold"
                   Margin="0,0,0,10" HorizontalOptions="Center" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding ImageUrls}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding .}" Aspect="AspectFill" HeightRequest="150" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Border>
</toolkit:Popup>