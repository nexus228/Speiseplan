<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Speiseplan.Views.DayPage"
             xmlns:model="clr-namespace:Speiseplan.Model"
             xmlns:viewmodel="clr-namespace:Speiseplan.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="DayPage">

    <Grid>

        <CollectionView ItemsSource="{Binding DayItems}" >

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
        Orientation="Vertical"
        ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Day">
                    <Border 
                StrokeShape="RoundRectangle 10"
                Stroke="Gold"
                StrokeThickness="2.5"                        
                BackgroundColor="Transparent"                                                    
                Margin="20">

                        <Border.Behaviors>
                            <toolkit:TouchBehavior
                                PressedScale="0.95"
                                PressedOpacity="0.7"/>
                        </Border.Behaviors>


                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DayPageViewModel}}, Path=ItemSelectedCommand}"
                        CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid>
                            <Image Source="menubackground_image.png" HeightRequest="125" Aspect="AspectFill"/>
                            <VerticalStackLayout Margin="25">

                                <Label
                            Text="{Binding Name}"
                            MaxLines="1"
                            
                            FontAttributes="Bold"
                            FontSize="Large"
                            TextColor="White" 
                            HorizontalTextAlignment="Center"/>

                                <Label
                            Text="{Binding DateText}"
                            FontAttributes="Bold"
                            FontSize="Medium"
                            TextColor="DarkGrey" 
                            HorizontalTextAlignment="Center" Margin="5"/>

                            </VerticalStackLayout>


                        </Grid>





                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
    
</ContentPage>