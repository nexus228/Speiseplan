<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Speiseplan.Views.EditMealPage"
             Title="EditMealPage">
    <VerticalStackLayout>

        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="150" />

        <ImageButton Source="pencil.png" Command="{Binding EditImageCommand}" HeightRequest="50" WidthRequest="50" />

        <Entry
             Text="{Binding Name, Mode=TwoWay}"
             VerticalTextAlignment="Center"
             TextColor="Black"
             FontSize="16" />

        <Button Text="Speichern" BackgroundColor="{DynamicResource Primary}" Command="{Binding SaveCommand}"/>

    </VerticalStackLayout>
</ContentPage>